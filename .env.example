# Sentinel Configuration
# Copy this file to .env and fill in your values

# API Key — used for authentication with the LLM provider
SENTINEL_API_KEY=sk-your-api-key-here

# Base URL — override to use a custom endpoint (OpenRouter, local inference, etc.)
# Default: https://api.openai.com/v1
SENTINEL_BASE_URL=

# Model — which model to use
# Default: gpt-4o
SENTINEL_MODEL=

# Max iterations per agent loop (default: 25)
SENTINEL_MAX_ITERATIONS=

# Log level: debug | info | warn | error (default: info)
SENTINEL_LOG_LEVEL=
